# OptionLab — Oracle Always-Free runtime environment
# Copy to /opt/optionlab/.env (the setup script writes this for you).

# SQLite lives on the persistent boot volume (or a mounted Block Volume at /data)
MARKET_DB_PATH=/opt/optionlab/data/market_data.sqlite

# Headless matplotlib MUST use the Agg backend (no display server on the VM)
MPLBACKEND=Agg

# Port gunicorn binds to (OCI does not inject PORT, so set it explicitly)
PORT=5001

# yfinance from Oracle's datacenter IP is frequently throttled by Yahoo.
# Leave unset for direct connect; if data comes back empty/429, point this at
# a reachable HTTP/SOCKS proxy (the app TCP-probes it and falls back to direct
# if unreachable — see utils/network.py::init_yf_proxy).
# YF_PROXY=http://your-proxy-host:1087

# Optional: auto top-up the DB daily so cached data never goes fully stale.
# Requires APScheduler (already in requirements.txt), lazily imported.
# AUTO_UPDATE_TICKERS=AAPL,MSFT,SPY

# Optional: disable the in-process per-IP rate limiter (leave unset in prod)
# RATE_LIMIT_DISABLED=1

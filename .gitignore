# OS
.DS_Store

# Per-task git worktrees (ADR 0009) — task checkouts live here, never in main workspace
.worktrees/

# Claude Code harness worktrees (EnterWorktree tool) — separate from ADR 0009's
# .worktrees/ above; each is its own git checkout and must never be tracked as a
# gitlink in the parent repo (git add -A here has bitten main more than once).
.claude/worktrees/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/

# IDE
.idea/
*.swp
*.swo

# Environment / secrets
.env

# Database (local dev data)
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# Jupyter
*.ipynb
.ipynb_checkpoints/

# Test / cache
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
coverage/

# Node / JS
node_modules/
npm-debug.log*

# Playwright
test-results/
playwright-report/
playwright/.cache/

# GitHub Pages build output — regenerated on every deploy by
# scripts/build_pages_site.py. Only site/fixtures/, site/snapshot/ and
# site/pages-shim.js are hand-maintained sources; everything else here was a
# committed shadow copy of static/ that drifted (see docs/l0_architecture.md §5).
site/index.html
site/static/
site/market-review/index.html
site/odds/index.html
site/payoff-ratio/index.html
site/option-chain/index.html
site/option-pricing-matrix/index.html
site/sim/index.html
site/showcase/*.html
